# Copy to backend/.env and fill in. Never commit .env. Never paste keys into source code.

# ---- LLM provider (set ONE key; leave both empty to run agents in labelled OFFLINE mode)
# Claude API key (https://console.anthropic.com)
ANTHROPIC_API_KEY=
# Sarvam AI key (https://dashboard.sarvam.ai -> API keys)
SARVAM_API_KEY=

# auto (Claude if its key is set, else Sarvam) | anthropic | sarvam
FIXCHAIN_LLM_PROVIDER=auto
# auto (llm if a key is set, else offline) | llm | offline
FIXCHAIN_AGENT_MODE=auto
FIXCHAIN_MODEL=claude-opus-5-5
# Sarvam model on /v2/chat/completions, e.g. sarvam-105b, glm5.3, deepseekv4.1-flash-1017
SARVAM_MODEL=sarvam-105b
# low | medium | high | max  (reasoning tokens share the max_tokens budget)
SARVAM_REASONING_EFFORT=medium

# HMAC secret shared by the mock gateway and simulated merchant. Random per run if empty.
GATEWAY_WEBHOOK_SECRET=

# Start the investigation pipeline automatically when an incident opens
FIXCHAIN_AUTO_INVESTIGATE=true
FIXCHAIN_MAX_REPAIR_ATTEMPTS=3

# Optional: require this token (X-Reviewer-Token) for approve/reject/rollback/reconcile/close.
# A reviewer name is always required. Leave empty for a local demo.
FIXCHAIN_REVIEWER_TOKEN=

# ---- Operations platform
# Demo mode seeds demo users and allows password-less demo sign-in (labelled in the UI). NOT production auth.
# Set to false in any shared/production deployment, together with FIXCHAIN_ADMIN_PASSWORD.
FIXCHAIN_DEMO_MODE=true
FIXCHAIN_ADMIN_PASSWORD=
FIXCHAIN_SESSION_TTL=43200
# In-process worker pool (threads in ONE server process - not cloud autoscaling)
FIXCHAIN_MIN_WORKERS=1
FIXCHAIN_MAX_WORKERS=12
FIXCHAIN_TASKS_PER_WORKER=15

# ---- Voice (Sarvam). Uses SARVAM_API_KEY above. Verify model names against the current Sarvam catalogue.
FIXCHAIN_VOICE=auto
SARVAM_STT_MODEL=saarika:v2.5
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_TTS_SPEAKER_EN=anushka
SARVAM_TTS_SPEAKER_HI=anushka
SARVAM_TTS_SPEAKER_MR=manisha

# ---- Vision: Claude vision when ANTHROPIC_API_KEY is set, else the labelled offline colour heuristic. auto | offline
FIXCHAIN_VISION=auto
